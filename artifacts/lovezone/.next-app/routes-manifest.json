{
  "version": 3,
  "pages404": true,
  "appType": "hybrid",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/certificates/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/certificates(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/favicon\\.svg(?:/)?$"
    },
    {
      "source": "/opengraph.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/opengraph\\.jpg(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/files/[...path]",
      "regex": "^/api/files/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/files/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/seo/[state]",
      "regex": "^/seo/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPstate": "nxtPstate"
      },
      "namedRegex": "^/seo/(?<nxtPstate>[^/]+?)(?:/)?$"
    },
    {
      "page": "/verify/[employeeId]",
      "regex": "^/verify/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPemployeeId": "nxtPemployeeId"
      },
      "namedRegex": "^/verify/(?<nxtPemployeeId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[state]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPstate": "nxtPstate"
      },
      "namedRegex": "^/(?<nxtPstate>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/api/admin",
      "regex": "^/api/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin(?:/)?$"
    },
    {
      "page": "/api/admin/certificate",
      "regex": "^/api/admin/certificate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/certificate(?:/)?$"
    },
    {
      "page": "/api/auth/login",
      "regex": "^/api/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/login(?:/)?$"
    },
    {
      "page": "/api/auth/logout",
      "regex": "^/api/auth/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/logout(?:/)?$"
    },
    {
      "page": "/api/auth/signup",
      "regex": "^/api/auth/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/signup(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/member",
      "regex": "^/member(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/member(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/seo/[state]",
      "routeKeys": {
        "nxtPstate": "nxtPstate"
      },
      "dataRouteRegex": "^/_next/data/CEOxGQ\\-yORsC5zPPSjvrx/seo/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/CEOxGQ\\-yORsC5zPPSjvrx/seo/(?<nxtPstate>[^/]+?)\\.json$"
    },
    {
      "page": "/sitemap.xml",
      "dataRouteRegex": "^/_next/data/CEOxGQ\\-yORsC5zPPSjvrx/sitemap.xml\\.json$"
    },
    {
      "page": "/[state]",
      "routeKeys": {
        "nxtPstate": "nxtPstate"
      },
      "dataRouteRegex": "^/_next/data/CEOxGQ\\-yORsC5zPPSjvrx/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/CEOxGQ\\-yORsC5zPPSjvrx/(?<nxtPstate>[^/]+?)\\.json$"
    }
  ],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}