  "scripts": {
    "dev": "pnpm --filter @workspace/lovezone dev",
    "start": "pnpm --filter @workspace/lovezone start",
    "build": "pnpm run typecheck && pnpm --filter @workspace/lovezone build",
    "typecheck:libs": "tsc --build",
